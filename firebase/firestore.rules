rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isTutorOfSession() {
      return signedIn() && resource.data.tutorId == request.auth.uid;
    }

    match /users/{uid} {
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow get: if signedIn() && (isOwner(uid) || resource.data.isTutor == true);
      allow list: if false;
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    match /subjects/{subjectId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.token.admin == true;
    }

    match /tutors/{tutorId} {
      allow read: if signedIn();
      allow create: if isOwner(tutorId)
        && get(/databases/$(database)/documents/users/$(tutorId)).data.isTutor == true;
      allow update: if isOwner(tutorId);
      allow delete: if false;

      match /availability/{slotId} {
        allow read: if signedIn();
        allow create, delete: if isOwner(tutorId);
        allow update: if isOwner(tutorId)
          || (
            signedIn()
            && resource.data.status == 'available'
            && request.resource.data.status == 'booked'
            && request.resource.data.bookedBy == request.auth.uid
          )
          || (
            signedIn()
            && resource.data.status == 'booked'
            && request.resource.data.status == 'available'
            && resource.data.bookedBy == request.auth.uid
          );
      }
    }

    match /sessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'confirmed'
        && request.resource.data.tutorId is string
        && request.resource.data.slotId is string;
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid || resource.data.tutorId == request.auth.uid);
      allow update: if signedIn()
        && (
          (
            resource.data.studentId == request.auth.uid
            && resource.data.status == 'confirmed'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.tutorId == resource.data.tutorId
            && request.resource.data.slotId == resource.data.slotId
          )
          || (
            resource.data.studentId == request.auth.uid
            && resource.data.status == 'completed'
            && resource.data.rating == null
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
          )
          || resource.data.tutorId == request.auth.uid
        );
      allow delete: if false;
    }

    match /ratings/{ratingId} {
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.sessionId == ratingId
        && get(/databases/$(database)/documents/sessions/$(ratingId)).data.studentId == request.auth.uid
        && get(/databases/$(database)/documents/sessions/$(ratingId)).data.status == 'completed';
      allow read: if signedIn()
        && (
          resource.data.studentId == request.auth.uid
          || resource.data.tutorId == request.auth.uid
        );
      allow update, delete: if false;
    }
  }
}
